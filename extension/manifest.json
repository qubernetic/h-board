{
  "manifest_version": 3,
  "name": "H-Board (dev)",
  "short_name": "H-Board",
  "version": "0.0.1",
  "description": "H-Board új tab oldal: fejlesztői próba. A lapot egy beállítható forrásról tölti be.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "H-Board: beállítások",
    "default_icon": {
      "16": "icons/toolbar-on-light-16.png",
      "24": "icons/toolbar-on-light-24.png",
      "32": "icons/toolbar-on-light-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
