{
  "name": "h-board",
  "version": "0.0.0",
  "private": true,
  "description": "H-Board: a start page for the browser's new tab",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "assets": "node scripts/check-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace @h-board/ui",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "2.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "6.4.6",
    "vitest": "5.1.1"
  }
}
