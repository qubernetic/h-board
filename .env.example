# Copy to .env. There are no secrets here: the setup code, passwords and tokens are never set in a
# file; the server keeps only their hashes. A secret added later gets a `changeme` value here.
# Every setting is explained in docs/server.md.

# The port on this machine (127.0.0.1) where the server answers.
HBOARD_PORT=8787
# 1 when the server runs behind your own reverse proxy: the slow-down of failed sign-ins then reads
# the caller's address from the last X-Forwarded-For entry. It is safe only with exactly one proxy in
# front that appends the caller's address to X-Forwarded-For, and with the server's port reachable
# only through that proxy; otherwise a caller can name any address. Leave 0 when nothing sits in front.
HBOARD_TRUST_PROXY=0
# Outside the image only: the folder of the database file (the image keeps it in /data).
# HBOARD_DATA_DIR=./data
