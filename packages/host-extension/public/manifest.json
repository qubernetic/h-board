{
  "manifest_version": 3,
  "name": "H-Board",
  "short_name": "H-Board",
  "version": "0.1.0.1",
  "version_name": "0.1.0-beta.1",
  "description": "A start page for the new tab: your sites in groups, kept on your own computer.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "h"
  },
  "permissions": ["storage", "offscreen"],
  "optional_permissions": ["bookmarks", "favicon"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "H-Board settings",
    "default_icon": {
      "16": "icons/toolbar-on-light-16.png",
      "24": "icons/toolbar-on-light-24.png",
      "32": "icons/toolbar-on-light-32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
